if(WIN32)
    if(CMAKE_SIZEOF_VOID_P EQUAL 4)
        list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}/artefacts/windows_32")
    else()
        list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}/artefacts/windows_64")
    endif()
elseif(APPLE)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
        list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}/artefacts/macos_arm64")
    else()
        list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}/artefacts/macos_64")
    endif()
else()
    if(CMAKE_SIZEOF_VOID_P EQUAL 4)
        list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}/artefacts/linux_32")
    else()
        list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}/artefacts/linux_64")
    endif()
endif()
